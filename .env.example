# Optional dedicated Base mainnet RPC. Public endpoint is used when empty.
BASE_RPC_URL=https://base-rpc.publicnode.com
# Organization API key, server-side only. Do not paste keys into chat or commit them.
KEEPERHUB_API_KEY=
# Separate local testnet execution key, never supplied to the web runtime.
KEEPERHUB_TESTNET_WRITE_KEY=
# Verify this against the organization wallet before authenticated simulation.
KEEPERHUB_EXPECTED_SENDER=
# Optional local JSON quote file for the observe command. No default cost is assumed.
RANGEPARK_ECONOMICS_FILE=
# Optional RETURN quote override; otherwise use the local quote from testnet:return-economics.
# All quotes expire; absent or stale estimates produce HOLD. Atomic test WETH units.
RANGEPARK_RETURN_ECONOMICS_FILE=
# Independent hosted read-only monitor credential; never a KeeperHub wallet key.
RETURN_MONITOR_TOKEN=
