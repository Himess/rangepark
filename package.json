{
  "name": "rangepark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic parking for fee-idle Uniswap V3 liquidity, powered by KeeperHub",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "demo": "tsx src/cli.ts demo",
    "inspect": "tsx src/cli.ts inspect",
    "observe": "tsx src/cli.ts observe",
    "discover": "tsx src/cli.ts discover",
    "preflight": "tsx src/cli.ts preflight",
    "connection": "tsx src/cli.ts connection",
    "testnet:check": "tsx scripts/check-testnet.ts",
    "testnet:oracle": "tsx scripts/testnet-oracle-setup.ts",
    "testnet:faucet-check": "tsx scripts/testnet-faucet-check.ts",
    "testnet:price-fixture": "tsx scripts/testnet-price-fixture.ts",
    "testnet:preflight": "tsx scripts/preflight-testnet.ts",
    "testnet:deposit": "tsx scripts/execute-testnet-deposit.ts",
    "testnet:park": "tsx scripts/testnet-park.ts",
    "testnet:repark": "tsx scripts/testnet-repark.ts",
    "testnet:return-check": "tsx scripts/testnet-return-check.ts",
    "testnet:return-economics": "tsx scripts/testnet-return-economics.ts",
    "testnet:return-monitor": "tsx scripts/testnet-return-monitor.ts",
    "testnet:return-observe": "tsx scripts/testnet-return-observe.ts",
    "testnet:return-run": "tsx scripts/testnet-return-run.ts",
    "testnet:restore": "tsx scripts/testnet-restore.ts",
    "test:fork": "tsx scripts/fork-lifecycle.ts",
    "test:fork-return": "tsx scripts/fork-testnet-return.ts",
    "test:fork-repark": "tsx scripts/fork-testnet-repark.ts",
    "test:fork-price-fixture": "tsx scripts/fork-testnet-price-fixture.ts",
    "test:fork-return-economics": "tsx scripts/fork-testnet-return-economics.ts",
    "sync:web": "node scripts/sync-web-core.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:timer": "node --test tests/monitor-tick.node.mjs",
    "check": "npm run typecheck && npm test && npm run test:timer"
  },
  "dependencies": {
    "@uniswap/sdk-core": "7.19.2",
    "@uniswap/v3-sdk": "3.31.3",
    "viem": "2.56.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@foundry-rs/anvil-win32-amd64": "1.7.1"
  }
}
